{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rotacast-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "rotacast-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "rotacast.api.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "rotacast-app",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "rotacast.api.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}