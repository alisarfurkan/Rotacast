<tr>
    <th class="saga">Yağış Etkinlik İndisi</th><td colspan="2" class="sola">15,41</td>
    <th class="saga">İklim Tipi</th><td colspan="2" class="sola">Yarı kurak</td>
</tr>

<tr><th colspan="10" class=" zemime3"><strong>DeMartonne İklim Sınıflandırması</strong></th></tr>
<tr>
    <th class="saga">Kuraklık İndisi</th><td colspan="2" class="sola">7,86</td>
    <th class="saga">İklim Tipi</th><td colspan="2" class="sola">Yarı Kurak</td>
</tr>

<tr><th colspan="10" class=" zemime3"><strong>Trewartha İklim Sınıflandırması</strong> <em>(evrensel sıcaklık ölçeğine göre)</em></th></tr>
<tr>
    <th class="saga">Kış mevsimi iklim tipi</th><td colspan="2" class="sola">Kışları soğuk,  (-0,19)</td>
    <th class="saga">Yaz mevsimi iklim tipi</th><td colspan="2" class="sola">Yazları sıcak (23,34)</td>
</tr>

<tr><th colspan="10" class=" zemime3"><strong>Thornthwaite İklim Sınıflandırması</strong></th></tr>
<tr>
    <th>İklim Sınıfı</th><td>D,B'1,d,b'3</td>
    <th><strong class="renk2">D</strong>: Yarı Kurak</td>
    <th><strong class="renk2">B'1</strong>: 1. Derece Mezotermal</td>
    <th><strong class="renk2">d</strong>: Su fazlası olamayan veya pek az olan</td>
    <th><strong class="renk2">b'3</strong>:  Yaz Buharlaşma Oranı : %56</td>
</tr>



