<script type="text/javascript">
var chart;
$(document).ready(function () {
    chart = new Highcharts.Chart({
        chart: { renderTo: 'containerGr', zoomType: 'xy' },
        title: { text: 'Karapınar' },
		subtitle: { text: 'İklim Diyagramı' },
		xAxis: [{ categories: ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'] }],
		yAxis: [
            { // Primary yAxis
                labels: { formatter: function () { return this.value + '°C'; }, style: { color: '#ff4040' } }, title: { text: 'Sıcaklık', style: { color: '#ff4040' } }, opposite: true
            },
            { // Secondary yAxis
                gridLineWidth: 0, title: { text: 'Yağış', style: { color: '#29ad29' } }, labels: { formatter: function () { return this.value + ' mm'; }, style: { color: '#29ad29' } }
            }
		],

		//tooltip: {formatter: function () {var unit = {'Yağış': 'mm', 'Sıcaklık': '°C'}[this.series.name]; return '' + this.x + ': ' + this.y + ' ' + unit;}},
		tooltip: { formatter: function () { var unit = { 'Yağış': 'mm', 'Sıcaklık': '°C' }[this.series.name]; return ''; } },
		legend: { layout: 'vertical', align: 'left', x: 120, verticalAlign: 'top', y: 30, floating: true, backgroundColor: '#ffffff' },
		series: [{ name: 'Yağış', color: '#29ad29', type: 'column', yAxis: 1, data: [30.8, 25.6, 26.9, 41.2, 37.1, 28.6, 8, 5.3, 7.7, 25.6, 23.5, 35.2] }, { name: 'Sıcaklık', color: '#ff4040', type: 'spline', data: [-0.9, 0.5, 4.7, 10.7, 15.3, 19.5, 22.8, 22, 17.5, 11.5, 5.2, 1.2] }]
	});
});
</script>


